# debian (glibc), not alpine: the admin "extract models" action runs
# scripts/extract-models.sh in-process, and that shells out to Source 2 Viewer's
# CLI — a self-contained .NET binary that won't run on musl. The apt packages
# are the script's own dependencies (it curls the CLI zip and drives a python
# pass over the composite-input vmats).
FROM node:22-bookworm-slim
# imagemagick converts the extracted econ icons to webp (~8x smaller than the
# PNG the CLI writes) and tints the graffiti stencils. Without it the extraction
# still completes, but falls back to shipping PNGs.
# `webp` provides cwebp — libwebp's own encoder. ImageMagick cannot replace it
# here: its WebP writer DROPS the RGB values of fully-transparent pixels, and
# `-define webp:exact=true` (the flag that would stop it) only exists in
# ImageMagick 7, while bookworm ships 6.9.11. Our textures are DATA, not
# pictures — the compositor samples pattern.rgb independently of pattern.a, and
# case hardening reads pattern.g as a ramp lookup — so colour under zero alpha
# is load-bearing and zeroing it renders skins as chrome. cwebp -exact keeps it,
# verified byte-identical, and its output is smaller than ImageMagick's anyway.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl unzip python3 libicu72 imagemagick webp \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/package.json ./
RUN npm install
COPY backend/ ./
# Same script the manual/host workflow uses — one copy, one behaviour.
COPY scripts/extract-models.sh /usr/local/bin/extract-models.sh
RUN chmod +x /usr/local/bin/extract-models.sh
EXPOSE 3000
CMD ["npm", "start"]
